include README.md
include LICENSE
include SECURITY.md
include CONTRIBUTING.md
include CHANGELOG.md
include AGENT.md
include plugin.yaml
include SECURE_HANDOFF_CONTRACT.md
include SECURE_HANDOFF_PROTOCOL.md
recursive-include plugin *.py *.yaml
recursive-include web *.html *.js *.css *.json *.md
recursive-include tests *.py *.mjs *.cjs
recursive-include docs *.md
prune .vercel
prune web/.vercel
exclude CURRENT.md
global-exclude *_REPORT.md
global-exclude .env*
global-exclude *.pyc
